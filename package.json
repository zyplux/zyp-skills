{
  "name": "zyp-skills",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "knip": "knip",
    "format": "prettier --write --cache --log-level warn .",
    "typecheck": "tsc -b",
    "lint": "eslint . --cache",
    "lint:fix": "pnpm run lint --fix",
    "test": "vitest run",
    "cz": "cz"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@zyplux/cz": "catalog:",
    "@zyplux/eslint-config": "catalog:",
    "@zyplux/tsconfig": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
